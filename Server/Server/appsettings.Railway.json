{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_URL}",
    "Redis": "${REDIS_URL}"
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://0.0.0.0:${PORT}"
      }
    }
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "https://justclimb-api.railway.app",
    "Audience": "justclimb-client",
    "ExpirationInMinutes": 1440
  },
  "Steam": {
    "AppId": "${STEAM_APP_ID}",
    "ApiKey": "${STEAM_API_KEY}",
    "WebApiUrl": "https://api.steampowered.com"
  },
  "RedisSyncConfig": {
    "BatchSize": 50,
    "FlushIntervalSeconds": 10,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "ConflictResolutionStrategy": "ServerWins"
  }
} 