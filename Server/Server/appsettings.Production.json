{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "api.justclimb.com,*.justclimb.com",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_SERVER};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=true;MultipleActiveResultSets=true",
    "Redis": "${REDIS_CONNECTION_STRING}"
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001"
      }
    },
    "Limits": {
      "MaxConcurrentConnections": 100,
      "MaxConcurrentUpgradedConnections": 100,
      "MaxRequestBodySize": 10485760,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30"
    }
  },
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "https://api.justclimb.com",
    "Audience": "justclimb-client",
    "ExpirationInMinutes": 1440
  },
  "Steam": {
    "AppId": "${STEAM_APP_ID}",
    "ApiKey": "${STEAM_API_KEY}",
    "WebApiUrl": "https://api.steampowered.com"
  },
  "Redis": {
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "InstanceName": "JustClimb_Prod",
    "DefaultDatabase": 0
  },
  "RedisSyncConfig": {
    "BatchSize": 100,
    "FlushIntervalSeconds": 5,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "ConflictResolutionStrategy": "ServerWins"
  },
  "Security": {
    "UseHttpsRedirection": true,
    "UseHsts": true,
    "HstsMaxAge": 365,
    "RequireHttps": true
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeout": 30,
    "RedisTimeout": 10
  },
  "Monitoring": {
    "EnableMetrics": true,
    "EnableDetailedErrors": false,
    "RequestLogging": false
  }
} 