graph TB
    %% 씬 플로우
    subgraph "🎮 게임 씬 플로우"
        Main["`**Main Scene**
        메인 메뉴
        - 게임 시작
        - 설정
        - 종료`"]
        
        Lobby["`**Lobby Scene**
        로비/허브
        - 캐릭터 확인
        - 스테이지 선택
        - 설정`"]
        
        SelectChar["`**SelectCharacter Scene**
        캐릭터 선택
        - 캐릭터 모델링
        - 스킨 선택
        - 능력치 확인`"]
        
        Stage1["`**Stage1 Scene**
        튜토리얼/기본 스테이지
        - 기본 조작 학습
        - 클라이밍 기초`"]
        
        Stage2["`**Stage2 Scene**
        중급 스테이지
        - 복합 동작
        - 파쿠르 요소`"]
        
        Stage3["`**Stage3 Scene**
        고급 스테이지
        - 고난이도 클라이밍
        - 타임 어택`"]
    end

    %% 씬 연결
    Main --> Lobby
    Lobby --> SelectChar
    Lobby --> Stage1
    Lobby --> Stage2
    Lobby --> Stage3
    SelectChar --> Lobby
    Stage1 --> Lobby
    Stage2 --> Lobby
    Stage3 --> Lobby

    %% 핵심 시스템
    subgraph "🏗️ 핵심 아키텍처"
        subgraph "🎯 Character System"
            CSController["`**CSPlayerController**
            클라이밍 전용 컨트롤러
            - 입력 처리
            - 상태 관리`"]
            
            LobbyChar["`**LobbyCharacter**
            로비 캐릭터
            - 카메라 제어
            - UI 상호작용`"]
        end

        subgraph "⚙️ Ability System"
            AbilityScheduler["`**AbilityScheduler**
            능력 스케줄러
            - 우선순위 관리
            - 능력 전환`"]
            
            ClimbAbility["`**ClimbAbility**
            등반 능력`"]
            
            WallRun["`**WallRun**
            벽 달리기`"]
            
            Vault["`**Vault**
            넘기 동작`"]
            
            DropToClimb["`**DropToClimb**
            떨어뜨리고 잡기`"]
        end

        subgraph "🔄 State Machine"
            ClimbContext["`**ClimbStateContext**
            상태 컨텍스트`"]
            
            IdleState["`**ClimbIdleState**
            매달리기 대기`"]
            
            UpState["`**ClimbUpState**
            올라가기`"]
            
            JumpState["`**ClimbJumpState**
            점프/이동`"]
            
            ShimmyState["`**ClimbShimmyState**
            옆으로 이동`"]
        end

        subgraph "🌍 Environment System"
            Ledge["`**Ledge**
            모서리 시스템`"]
            
            Ladder["`**Ladder**
            사다리 시스템`"]
            
            WallRunTrigger["`**WallRunTrigger**
            벽 달리기 구간`"]
        end

        subgraph "🎨 Visual System"
            ClimbIK["`**ClimbIK**
            손 위치 IK`"]
            
            IKScheduler["`**IKScheduler**
            IK 스케줄러`"]
            
            CameraFollow["`**CameraTargetFollow**
            카메라 추적`"]
        end

        subgraph "🔊 Audio System"
            AudioPlayer["`**CharacterAudioPlayer**
            캐릭터 오디오`"]
        end

        subgraph "💖 Game Systems"
            Health["`**Health**
            체력 시스템`"]
            
            DamageTrigger["`**DamageTrigger**
            데미지 트리거`"]
        end
    end

    %% 시스템 연결
    CSController --> AbilityScheduler
    AbilityScheduler --> ClimbAbility
    AbilityScheduler --> WallRun
    AbilityScheduler --> Vault
    AbilityScheduler --> DropToClimb
    
    ClimbAbility --> ClimbContext
    ClimbContext --> IdleState
    ClimbContext --> UpState
    ClimbContext --> JumpState
    ClimbContext --> ShimmyState
    
    CSController --> ClimbIK
    ClimbIK --> IKScheduler
    CSController --> CameraFollow
    CSController --> AudioPlayer
    
    %% 환경과의 상호작용
    ClimbAbility -.-> Ledge
    ClimbAbility -.-> Ladder
    WallRun -.-> WallRunTrigger
    
    %% 게임 시스템 연결
    CSController --> Health
    Health --> DamageTrigger

    %% 씬별 시스템 매핑
    Main -.-> LobbyChar
    Lobby -.-> LobbyChar
    SelectChar -.-> LobbyChar
    Stage1 -.-> CSController
    Stage2 -.-> CSController
    Stage3 -.-> CSController

    %% 스타일링
    classDef sceneStyle fill:#e1f5fe,stroke:#01579b,stroke-width:2px,color:#000
    classDef systemStyle fill:#f3e5f5,stroke:#4a148c,stroke-width:2px,color:#000
    classDef abilityStyle fill:#e8f5e8,stroke:#1b5e20,stroke-width:2px,color:#000
    classDef stateStyle fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#000
    classDef envStyle fill:#fce4ec,stroke:#880e4f,stroke-width:2px,color:#000

    class Main,Lobby,SelectChar,Stage1,Stage2,Stage3 sceneStyle
    class CSController,LobbyChar,AbilityScheduler systemStyle
    class ClimbAbility,WallRun,Vault,DropToClimb abilityStyle
    class ClimbContext,IdleState,UpState,JumpState,ShimmyState stateStyle
    class Ledge,Ladder,WallRunTrigger envStyle